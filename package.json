{
  "name": "tokenless-zendesk-mcp",
  "version": "0.3.0",
  "description": "MCP server for Zendesk: interactive Playwright login, then the saved session cookies are used to call the Zendesk REST API.",
  "type": "module",
  "license": "MIT",
  "author": "yutamago",
  "homepage": "https://github.com/yutamago/tokenless-zendesk-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yutamago/tokenless-zendesk-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/yutamago/tokenless-zendesk-mcp/issues"
  },
  "keywords": [
    "mcp",
    "zendesk",
    "model-context-protocol",
    "claude"
  ],
  "bin": {
    "zendesk-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "login": "node dist/index.js login"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "playwright": "^1.48.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
